PORT=3100
HOST=127.0.0.1
NODE_ENV=development
DEV_AUTH=true
# 设置至少 12 位密码后启用后台登录；无默认管理员密码。
ADMIN_PASSWORD=
DATA_DRIVER=file
DATA_DIR=./data
UPLOAD_DIR=./uploads
# 后配数据库。启用 PostgreSQL 时将 DATA_DRIVER 改为 postgres。
DATABASE_URL=postgresql://fishing:CHANGE_ME@127.0.0.1:5432/fishing
POSTGRES_PASSWORD=CHANGE_ME
# Cookie 在 HTTPS 正式部署时必须为 true。
COOKIE_SECURE=false
# 不对外返回；地图 JS Key 在管理后台配置。
AMAP_SERVICE_KEY=
WEATHER_PROVIDER=disabled
QWEATHER_HOST=
QWEATHER_API_KEY=
